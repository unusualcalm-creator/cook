.title {
  display: block;
  margin-bottom: 8rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.tools {
  margin-top: 24rpx;
  padding: 22rpx;
}

.block-title {
  display: block;
  margin-bottom: 14rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.progress-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
}

.progress-text {
  color: #166534;
  font-size: 26rpx;
  font-weight: 800;
}

.progress-bar {
  overflow: hidden;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #dcfce7;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #16a34a;
}

.prep-step {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.prep-step.is-done {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #dc2626;
  font-size: 26rpx;
  font-weight: 800;
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.step-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.step-action {
  display: block;
  margin-top: 12rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.55;
}

.info-block {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f0fdf4;
}

.info-label {
  display: block;
  color: #166534;
  font-size: 24rpx;
  font-weight: 800;
}

.info-text {
  display: block;
  margin-top: 6rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.5;
}

.start-button {
  margin-top: 30rpx;
}
