.hero {
  padding: 36rpx 28rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #b91c1c;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #fecaca;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-copy {
  display: block;
  margin-top: 12rpx;
  color: #fee2e2;
  font-size: 28rpx;
  line-height: 1.5;
}

.search-row {
  margin-top: 24rpx;
}

.search-input {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.category-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 12rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  color: #166534;
  border: 1rpx solid #bbf7d0;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}

.category-chip.is-active {
  color: #ffffff;
  border-color: #15803d;
  background: #15803d;
}

.recipe-card {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.recipe-cover {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #fef2f2;
}

.recipe-content {
  padding: 24rpx;
}

.recipe-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.recipe-name {
  color: #111827;
  font-size: 36rpx;
  font-weight: 800;
}

.difficulty {
  flex: 0 0 auto;
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 700;
}

.meta-row {
  display: flex;
  gap: 18rpx;
  margin: 18rpx 0;
  color: #4b5563;
  font-size: 26rpx;
}
