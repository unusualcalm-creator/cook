page {
  min-height: 100vh;
  color: #1f2937;
  background: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
}

view,
text,
button,
input,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 8px;
  font-weight: 600;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #166534;
  background: #dcfce7;
  font-size: 24rpx;
}

.primary-button {
  height: 88rpx;
  color: #ffffff;
  background: #dc2626;
  font-size: 30rpx;
  line-height: 88rpx;
}

.secondary-button {
  height: 88rpx;
  color: #166534;
  border: 1rpx solid #86efac;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.ghost-button {
  height: 76rpx;
  color: #374151;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.empty {
  padding: 56rpx 24rpx;
  color: #6b7280;
  text-align: center;
}
